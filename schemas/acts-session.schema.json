{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uconn-law-library.github.io/CGS/schemas/acts-session.schema.json",
  "title": "CGS Public and Special Acts for one legislative session",
  "type": "object",
  "required": ["schemaVersion", "session", "acts"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "session": {
      "type": "object",
      "required": ["id", "year", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^\\d{4}-[a-z0-9-]+$" },
        "year": { "type": "integer", "minimum": 1900 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "acts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "number", "citation", "title", "bill", "billUrl", "url"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(?:pa|sa)-\\d{4}-[a-z0-9-]+-\\d+$" },
          "type": { "enum": ["public", "special"] },
          "number": { "type": "integer", "minimum": 1 },
          "citation": { "type": "string", "pattern": "^(?:P|S)\\.A\\. \\d{2}-\\d+(?: \\(.+\\))?$" },
          "title": { "type": "string", "minLength": 1 },
          "bill": { "type": "string", "pattern": "^(?:HB|SB) \\d+$" },
          "billUrl": { "type": "string", "format": "uri", "pattern": "^https://www\\.cga\\.ct\\.gov/" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://www\\.cga\\.ct\\.gov/" }
        }
      }
    }
  }
}
