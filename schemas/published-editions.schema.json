{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uconn-law-library.github.io/CGS/schemas/published-editions.schema.json",
  "title": "Published General Statutes editions",
  "description": "Editions confirmed on cga.ct.gov. The guide labels these years published; a rollover adds a revision and supplement discovery adds a supplement, each in a reviewed data pull request.",
  "type": "object",
  "required": ["schemaVersion", "editions"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "editions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["year", "kind", "url"],
        "additionalProperties": false,
        "properties": {
          "year": { "type": "integer", "minimum": 1958 },
          "kind": { "enum": ["revision", "supplement"] },
          "url": { "type": "string", "pattern": "^https://www[.]cga[.]ct[.]gov/[0-9]{4}/(pub|sup)/titles[.]htm$" },
          "verifiedFrom": { "type": "string", "pattern": "^https://" },
          "heading": { "type": "string" }
        }
      }
    }
  }
}
